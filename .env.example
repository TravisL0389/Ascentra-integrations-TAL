# Frontend (Vite) — required for the app to connect to your Supabase project.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Edge function secrets — set these in the Supabase dashboard as FUNCTION secrets
# (they are NOT bundled into the frontend; values here are only for local dev
# with `supabase functions serve`).
# SUPABASE_SERVICE_ROLE_KEY is injected automatically by hosted Supabase.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
TAL_WORKER_KEY=a-random-worker-shared-secret
TAL_CREDENTIALS_KEY=a-random-credential-encryption-key